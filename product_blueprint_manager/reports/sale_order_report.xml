<odoo>
    <!-- Página individual: 1 plano = 1 llamada a web.external_layout -->
    <template id="report_sale_order_blueprint_page">
        <!-- Variables esperadas por el layout -->
        <t t-set="o" t-value="doc"/>
        <t t-set="company_id" t-value="doc.company_id"/>

        <!--
            Direcciones del pedido.
            Se reproduce la lógica nativa de sale.report_saleorder_document:
            - partner_id: cliente/contacto seleccionado en la venta.
            - partner_invoice_id: dirección de facturación.
            - partner_shipping_id: dirección de entrega.
        -->

        <t t-set="p" t-value="doc.partner_id"/>

        <!-- Dirección principal: cliente/contacto seleccionado en la venta -->
        <t t-set="address">
            <div
                t-field="doc.partner_id"
                t-options="{
                    'widget': 'contact',
                    'fields': ['name',  'address', 'phone', 'mobile', 'email'],
                    'no_marker': True
                }"
            />

            <p t-if="doc.partner_id.vat" class="mb-0">
                <t
                    t-if="doc.company_id.account_fiscal_country_id.vat_label"
                    t-out="doc.company_id.account_fiscal_country_id.vat_label"
                />
                <t t-else="">Tax ID</t>:
                <span t-field="doc.partner_id.vat"/>
            </p>
        </t>

        <!--
            Facturación / entrega.
            Mismo criterio que utiliza Odoo en el informe nativo de ventas.
        -->
        <t
            t-if="
                (
                    doc.partner_shipping_id == doc.partner_invoice_id
                    and doc.partner_invoice_id != doc.partner_id
                )
                or doc.partner_shipping_id != doc.partner_invoice_id
            "
        >
            <t t-set="information_block">

                <strong>
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                        Invoicing and Shipping Address
                    </t>
                    <t t-else="">
                        Invoicing Address
                    </t>
                </strong>

                <div
                    t-field="doc.partner_invoice_id"
                    t-options="{
                        'widget': 'contact',
                        'fields': ['name',  'address', 'phone', 'mobile', 'email'],
                        'no_marker': True,
                        'phone_icons': True
                    }"
                />

                <p t-if="doc.partner_invoice_id.vat" class="mb-0">
                    <t
                        t-if="doc.company_id.account_fiscal_country_id.vat_label"
                        t-out="doc.company_id.account_fiscal_country_id.vat_label"
                    />
                    <t t-else="">Tax ID</t>:
                    <span t-field="doc.partner_invoice_id.vat"/>
                </p>

                <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                    <strong class="d-block mt-3">
                        Shipping Address
                    </strong>

                    <div
                        t-field="doc.partner_shipping_id"
                        t-options="{
                            'widget': 'contact',
                            'fields': ['name',  'address', 'phone', 'mobile', 'email'],
                            'no_marker': True,
                            'phone_icons': True
                        }"
                    />
                </t>

            </t>
        </t>
        <t t-call="web.external_layout">
            <style>
                .o_report_layout_standard .address.row { margin-bottom: 6px !important; }
                .pbm-tight h2 { margin: 0 0 4px 0; font-size: 14px; }
                .pbm-tight table { margin: 4px 0; }
                .pbm-tight ul { margin: 0; padding-left: 12px; }
                .pbm-tight .compact-lines { line-height: 1; }
                .pbm-tight .page { padding-top: 0; }
            </style>

            <div class="page pbm-tight" style="page-break-after: always;">
                <h2>Pedido: <t t-out="doc.name"/></h2>

                <table style="width:100%;">
                    <tr>
                        <td class="compact-lines" style="vertical-align:top; width:50%;">
                            <p><span t-field="doc.date_order" t-options="{'widget':'date'}"/></p>

                            <!-- Producto (solo nombre base, sin la descripción larga con atributos) -->
                            <p><t t-out="line.product_id.product_tmpl_id.name"/></p>

                            <!-- Nº de línea REAL (1,2,3...) -->
                            <p>Línea del pedido: <t t-esc="line_index + 1"/></p>

                            <p>Plano: <t t-out="blueprint['blueprint_name']"/></p>
                        </td>

                        <td class="compact-lines" style="vertical-align:top; width:50%;">
                            <t t-set="disp_attrs" t-value="line._get_blueprint_display_attributes()"/>
                            <t t-if="disp_attrs">
                                <ul>
                                    <t t-foreach="disp_attrs" t-as="it">
                                        <li><t t-esc="it['attr']"/>: <t t-esc="it['value']"/></li>
                                    </t>
                                </ul>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Clave para que NO cree la “página 2”: limita altura -->
                <img t-if="'png_base64' in blueprint"
                     t-att-src="'data:image/png;base64,' + blueprint['png_base64']"
                     style="max-width:100%; max-height:650px; height:auto; width:auto; display:block; margin:0 auto;"/>
            </div>
        </t>
    </template>

    <!-- Documento: recorre líneas y planos, y para cada plano llama a la página -->
    <template id="report_sale_order_blueprint_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>

        <t t-foreach="doc.order_line" t-as="line" t-index="line_index">
            <t t-set="evaluated_blueprints" t-value="line._get_evaluated_blueprint()"/>
            <t t-if="evaluated_blueprints and len(evaluated_blueprints) > 0">
                <t t-foreach="evaluated_blueprints" t-as="blueprint">
                    <t t-call="product_blueprint_manager.report_sale_order_blueprint_page"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Envoltorio -->
    <template id="report_sale_order_blueprint">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc"/>
                <t t-call="product_blueprint_manager.report_sale_order_blueprint_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
