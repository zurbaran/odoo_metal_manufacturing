<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_blueprint" model="ir.module.category">
        <field name="name">Product Blueprints</field>
        <field name="description">
            Controls access to product blueprints, formulas and blueprint generation.
        </field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_product_blueprint" model="res.groups.privilege">
        <field name="name">Product Blueprints</field>
        <field name="category_id" ref="module_category_product_blueprint"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_product_blueprint_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_product_blueprint"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_product_blueprint_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_product_blueprint"/>
        <field
            name="implied_ids"
            eval="[(4, ref('group_product_blueprint_user'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
