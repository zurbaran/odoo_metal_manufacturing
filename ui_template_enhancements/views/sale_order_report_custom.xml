<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
      ============================================================================
      Personalización del presupuesto / pedido de venta
      ============================================================================
      - Amplía los datos de contacto.
      - Mantiene las direcciones de facturación y envío.
      - Conserva el NIF de la dirección de facturación cuando el bloque principal
        duplicado se oculte en el diseño global.
      - Oculta impuestos por línea.
      - Oculta unidades secundarias en ventas.
      - No crea otra tabla de productos opcionales: se usa la nativa.
      ============================================================================
  -->
  <template
    id="ui_template_enhancements_sale_report_mod"
    inherit_id="sale.report_saleorder_document"
    name="Custom Sale Order Report Enhancements"
    priority="1001"
  >
    <!-- Dirección principal enriquecida. -->
    <xpath expr="//t[@t-set='address']/div" position="attributes">
      <attribute name="t-options">
        {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True}
      </attribute>
    </xpath>

    <!--
        Dirección de facturación enriquecida.
        Se añade también el NIF para no perderlo cuando partner_id coincide con
        una dirección que ya está representada en information_block.
    -->
    <xpath
      expr="//t[@t-set='information_block']/div[@t-field='doc.partner_invoice_id']"
      position="replace"
    >
      <div
        t-field="doc.partner_invoice_id"
        t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True, 'phone_icons': True}"
      />
      <p t-if="doc.partner_invoice_id.vat" class="mb-0">
        <t
          t-if="doc.company_id.account_fiscal_country_id.vat_label"
          t-out="doc.company_id.account_fiscal_country_id.vat_label"
        />
        <t t-else="">Tax ID</t>:
        <span t-field="doc.partner_invoice_id.vat"/>
      </p>
    </xpath>

    <!-- Dirección de envío enriquecida cuando es distinta. -->
    <xpath
      expr="//t[@t-set='information_block']/t[@t-if='doc.partner_shipping_id != doc.partner_invoice_id']"
      position="replace"
    >
      <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
        <strong class="d-block mt-3">Shipping Address</strong>
        <div
          t-field="doc.partner_shipping_id"
          t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True, 'phone_icons': True}"
        />
      </t>
    </xpath>

    <!-- Ocultar impuestos por línea; los totales fiscales permanecen. -->
    <xpath expr="//th[@name='th_taxes']" position="replace"/>
    <xpath expr="//td[@name='td_taxes']" position="replace"/>

    <!--
        No se redefine table_optional_products.
        sale_management conserva su tabla nativa, incluida la columna de
        descuento condicional.
    -->

    <!-- Ocultar unidades secundarias únicamente en ventas. -->
    <xpath expr="//th[@name='th_secondary_uom_id']" position="replace"/>
    <xpath expr="//td[@name='td_secondary_uom_id']" position="replace"/>
  </template>
</odoo>
