<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="ui_template_enhancements_sale_report_mod"
        inherit_id="sale.report_saleorder_document"
        name="Custom Sale Order Report Enhancements"
        priority="1001"
    >
        <!-- Enrich the main customer address. -->
        <xpath
            expr="//t[@t-set='address']/div[@t-field='doc.partner_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True}
            </attribute>
        </xpath>

        <!-- Odoo 19 has separate structures for combined and split addresses. -->
        <xpath
            expr="//t[@t-set='information_block']/t[@t-if='doc.partner_shipping_id == doc.partner_invoice_id']/div[@t-field='doc.partner_invoice_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True, 'phone_icons': True}
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-set='information_block']/t[@t-if='doc.partner_shipping_id == doc.partner_invoice_id']/div[@t-field='doc.partner_invoice_id']"
            position="after"
        >
            <p t-if="doc.partner_invoice_id.vat" class="mb-0">
                <t
                    t-if="doc.company_id.account_fiscal_country_id.vat_label"
                    t-out="doc.company_id.account_fiscal_country_id.vat_label"
                />
                <t t-else="">Tax ID</t>:
                <span t-field="doc.partner_invoice_id.vat"/>
            </p>
        </xpath>

        <xpath
            expr="//t[@t-set='information_block']/div[@class='row']//div[@t-field='doc.partner_invoice_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True, 'phone_icons': True}
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-set='information_block']/div[@class='row']//div[@t-field='doc.partner_invoice_id']"
            position="after"
        >
            <p t-if="doc.partner_invoice_id.vat" class="mb-0">
                <t
                    t-if="doc.company_id.account_fiscal_country_id.vat_label"
                    t-out="doc.company_id.account_fiscal_country_id.vat_label"
                />
                <t t-else="">Tax ID</t>:
                <span t-field="doc.partner_invoice_id.vat"/>
            </p>
        </xpath>

        <xpath
            expr="//t[@t-set='information_block']/div[@class='row']//div[@t-field='doc.partner_shipping_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True, 'phone_icons': True}
            </attribute>
        </xpath>

        <!-- Hide line tax columns while keeping fiscal totals. -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_product_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_section_group_taxes']" position="replace"/>

        <!-- Hide the secondary unit column added by sale_order_secondary_unit. -->
        <xpath expr="//th[@name='th_secondary_uom_id']" position="replace"/>
        <xpath expr="//td[@name='td_secondary_uom_id']" position="replace"/>
    </template>
</odoo>
