<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="invoice_report_custom"
        inherit_id="account.report_invoice_document"
        name="Custom Invoice Report Enhancements"
        priority="99"
    >
        <xpath
            expr="//div[@name='shipping_address_block']//div[@t-field='o.partner_shipping_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True}
            </attribute>
        </xpath>

        <xpath
            expr="//div[@name='address_not_same_as_shipping']//address[@t-field='o.partner_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True}
            </attribute>
        </xpath>
        <xpath
            expr="//div[@name='address_same_as_shipping']//address[@t-field='o.partner_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True}
            </attribute>
        </xpath>
        <xpath
            expr="//div[@name='no_shipping']//address[@t-field='o.partner_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile', 'email'], 'no_marker': True}
            </attribute>
        </xpath>

        <!-- Odoo 19 renders normal and grouped invoice lines separately. -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_taxes_grouped']" position="replace"/>
    </template>
</odoo>
