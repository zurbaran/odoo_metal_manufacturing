<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
      Formato único para documentos externos con direcciones.

      La cabecera contiene únicamente logo/lema.
      Los datos de empresa y destinatario están en el cuerpo del documento.

      margin_top=45:
      - reserva la zona superior para la cabecera.

      header_spacing=40:
      - mantiene logo/lema suficientemente arriba;
      - evita que la cabecera invada las direcciones;
      - es menor que los 52 mm estándar de Odoo para aprovechar mejor
        el espacio vertical.
  -->
  <record id="paperformat_ute_external_compact" model="report.paperformat">
    <field name="name">A4 - UTE Externo Compacto</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="page_height">0</field>
    <field name="page_width">0</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">34</field>
    <field name="margin_bottom">32</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">29</field>
    <field name="dpi">90</field>
    <field name="css_margins" eval="True"/>
  </record>

  <function
    model="ir.actions.report"
    name="_ute_apply_compact_external_paperformat"
  />
</odoo>
