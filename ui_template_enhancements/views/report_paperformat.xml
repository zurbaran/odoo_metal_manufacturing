<odoo>
    <!-- =========================
            PAPERFORMATS ESPECÍFICOS
            ========================= -->

    <record id="paperformat_ute_sale_external" model="report.paperformat">
        <field name="name">A4 - UTE Venta</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">72</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">72</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="paperformat_ute_purchase_external" model="report.paperformat">
        <field name="name">A4 - UTE Compra</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">86</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">86</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="paperformat_ute_account_external" model="report.paperformat">
        <field name="name">A4 - UTE Factura</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">80</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">80</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>


    <!-- =========================
            ASIGNAR A INFORMES VENTA
            ========================= -->

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_sale_external"/>
    </record>

    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_sale_external"/>
    </record>


    <!-- =========================
            ASIGNAR A INFORMES COMPRA
            ========================= -->

    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_purchase_external"/>
    </record>

    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_purchase_external"/>
    </record>


    <!-- =========================
            ASIGNAR A INFORMES FACTURA
            ========================= -->

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_account_external"/>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_account_external"/>
    </record>

    <record id="account.action_account_original_vendor_bill" model="ir.actions.report">
        <field name="paperformat_id" ref="ui_template_enhancements.paperformat_ute_account_external"/>
    </record>
</odoo>
