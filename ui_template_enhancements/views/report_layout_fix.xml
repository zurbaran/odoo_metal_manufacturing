<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Alinea el bloque de destinatario (address) con el bloque de empresa, en el header -->
  <template
    id="ui_external_layout_standard_align_address"
    inherit_id="web.external_layout_standard"
    priority="99"
  >
    <!-- 1) Quitar el address_layout del article (para que no aparezca “más abajo”)
         y meter un separador REAL entre cabecera y contenido -->
    <xpath
      expr="//div[contains(@t-attf-class,'article')]/t[@t-call='web.address_layout']"
      position="replace"
    >
    </xpath>

    <!-- 2) Insertar columna derecha (destinatario) en el header, alineada con la empresa -->
    <xpath
      expr="//div[contains(@t-attf-class,'header')]/div[@class='row']/div[@name='company_address']"
      position="after"
    >
      <div class="col-6" name="recipient_address">
        <t t-if="address or information_block">
          <ul class="list-unstyled ute-recipient" name="recipient_address_list">
            <li t-if="information_block">
              <t t-out="information_block" />
            </li>
            <li t-if="address">
              <!-- Usar t-esc como web.address_layout: respeta Markup -->
              <t t-esc="address" />
            </li>
          </ul>
        </t>

        <!-- Si quieres permitir extensiones futuras, deja oe_structure con id válido -->
        <div class="oe_structure" id="oe_structure_recipient_address" t-else="" />
      </div>

      <!-- 3) Forzar alineación consistente -->
      <style>
        .ute-recipient, .ute-recipient * { text-align: left !important; }
        .ute-recipient .o_force_ltr { display: block; text-align: inherit !important; }
        .ute-recipient a { text-align: inherit !important; }
      </style>
    </xpath>
  </template>
</odoo>
